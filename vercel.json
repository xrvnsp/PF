{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "srvnsp.vercel.app"
        }
      ],
      "destination": "https://www.xrvnsp.qd.je/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/admin/", "destination": "/admin/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*resume.*|.*Resume.*)",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"Saravana Prakash_XR Developer_4Y_Exp_Resume.pdf\""
        }
      ]
    },
    {
      "source": "/assets/resume.pdf",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"Saravana Prakash_XR Developer_4Y_Exp_Resume.pdf\""
        }
      ]
    }
  ]
}
